{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && pnpm run build:sw",
    "build:sw": "vite build --config vite.sw.config.ts",
    "dev": "vite",
    "check": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.sw.json --noEmit && svelte-check --tsconfig tsconfig.json",
    "format": "oxfmt --write . vite.config.ts",
    "format:check": "oxfmt --check . vite.config.ts",
    "lint": "oxlint . vite.config.ts --ignore-pattern '**/node_modules/**'",
    "test": "vitest run"
  },
  "dependencies": {
    "bits-ui": "2.20.2",
    "geist": "1.8.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "image-size": "^2.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "phoenix_vite": "file:../deps/phoenix_vite",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
