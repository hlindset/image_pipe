# The directory Mix will write compiled artifacts to.
/_build/

# Dialyzer PLT files
/priv/plts/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
gavekort-*.tar


# IDEA settings
.idea

# per-user configs
config/*.dev.exs
config/*.test.exs

# ignore .DS_Store files
.DS_Store

# Local git worktrees
.worktrees/
.claude/worktrees/

# Setup log written by the WorktreeCreate hook (scripts/worktree-create.sh)
.worktree-setup.log

# Various local deploy files
local

# Downloaded db tables, script config file
scripts/*.csv
scripts/scrubbed_prod_config.py
__pycache__

# Machine-local mise config (e.g. PLATFORM_PROVIDED_LIBVIPS / VIX_LIBVIPS_PREFIX overrides)
mise.local.toml
.mise.local.toml

# Generated benchmark output
bench/results/
tmp/

# Generated imgproxy differential visual-diff report (regenerate on demand)
test/support/image_pipe/test/imgproxy_differential/report.html

# Generated TwicPics differential visual-diff report (regenerate on demand)
test/support/image_pipe/test/twicpics_differential/report.html
