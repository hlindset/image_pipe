{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/cloud-session-start.sh\"; PATH=\"$PATH:$HOME/.local/share/mise/shims\" bd prime --hook-json",
            "type": "command",
            "timeout": 1200
          }
        ],
        "matcher": ""
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/scripts/worktree-create.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/writing-docs-pr-gate.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
