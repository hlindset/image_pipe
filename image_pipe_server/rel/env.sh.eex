#!/bin/sh
# Erlang distribution would listen on every interface and accept the cookie
# that `mix release` wrote into the release, which anyone with the release or
# its image can read. It stays off unless RELEASE_DISTRIBUTION is set.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# libvips allocates from many threads, and glibc's per-thread arenas keep the
# memory it frees. jemalloc returns it. The image ships jemalloc at this path.
# IMAGE_PIPE_ALLOCATOR=glibc keeps glibc, and so does a jemalloc that can't
# load, such as one built for another page size than the kernel's. glibc then
# gets two arenas.
jemalloc=/usr/local/lib/libjemalloc.so.2
if [ "${IMAGE_PIPE_ALLOCATOR:-jemalloc}" = jemalloc ] && [ -e "$jemalloc" ] &&
  LD_PRELOAD="$jemalloc" /bin/true 2>/dev/null; then
  export LD_PRELOAD="$jemalloc${LD_PRELOAD:+:$LD_PRELOAD}"
else
  export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
fi

# libvips sizes each pipeline's thread pool from the host's cores, not the
# container's CPU limit, so set VIPS_CONCURRENCY from the cgroup quota unless
# it's set. Without a quota, libvips uses every core.
if [ -z "${VIPS_CONCURRENCY:-}" ]; then
  quota=
  period=
  if [ -r /sys/fs/cgroup/cpu.max ]; then
    read -r quota period < /sys/fs/cgroup/cpu.max
  elif [ -r /sys/fs/cgroup/cpu/cpu.cfs_quota_us ]; then
    read -r quota < /sys/fs/cgroup/cpu/cpu.cfs_quota_us
    read -r period < /sys/fs/cgroup/cpu/cpu.cfs_period_us
  fi

  case "$quota" in
    "" | max | -1) ;;
    *) export VIPS_CONCURRENCY=$(((quota + period - 1) / period)) ;;
  esac
fi
